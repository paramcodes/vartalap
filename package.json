{
  "name": "vartalap",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter='*' typecheck",
    "db:generate": "bun run --filter=@vartalap/database generate",
    "db:migrate": "bun run --filter=@vartalap/database migrate",
    "db:push": "bun run --filter=@vartalap/database push",
    "db:studio": "bun run --filter=@vartalap/database studio",
    "db:local": "bun run scripts/db-local.ts",
    "db:setup": "bun run scripts/db-local.ts --migrate",
    "check:tokens": "bun run scripts/check-prototype-tokens.ts",
    "proto": "bun run scripts/serve-prototype.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
