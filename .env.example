# Local development. NOTHING HERE IS A SECRET, and nothing here is a production value.
#
# The pooled URL is what the app uses. The direct URL is what migrations use — Neon's
# pooled endpoint multiplexes over a small number of backends and session-scoped state
# (prepared statements, advisory locks) misbehaves behind it. That matters here
# specifically: the send path holds `pg_advisory_xact_lock`, which is one line carrying
# the entire anti-inversion guarantee (ADR 0005).
DATABASE_URL=postgres://vartalap:vartalap@localhost:5433/vartalap
DIRECT_DATABASE_URL=postgres://vartalap:vartalap@localhost:5433/vartalap

# Bun and Centrifugo run locally; see docker-compose.yml for the database only.
CENTRIFUGO_URL=http://localhost:8000/connection/websocket
CENTRIFUGO_API=http://localhost:8000/api
REDIS_URL=redis://localhost:6379

# Where the presigned-upload bucket lives. The worker is the only content gate —
# a presigned URL signs what the client SAID (ADR 0008).
R2_ENDPOINT=
R2_BUCKET=vartalap-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_ORIGIN=https://media.example.com

# Better Auth. The secret is generated, never committed, and rotated after every
# restore — a restore resurrects revoked sessions (hardening item H-11).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000